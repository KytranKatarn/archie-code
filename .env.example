# ARCHIE Code CLI — environment configuration
# Copy to .env and fill in ARCHIE_HUB_API_KEY

# Hub connectivity (points to the A.R.C.H.I.E. platform)
ARCHIE_HUB_URL=http://192.168.1.200:3000
ARCHIE_HUB_API_KEY=           # Set to your platform API key

# Platform URL for direct KB search fallback (no auth required for /api/knowledge/search)
ARCHIE_PLATFORM_URL=http://192.168.1.200:3000

# Ollama (local inference)
OLLAMA_HOST=http://192.168.1.200:11434
ARCHIE_MODEL=archie:7b

# WebSocket server (TUI connects here)
ARCHIE_WS_HOST=127.0.0.1
ARCHIE_WS_PORT=9090

# Platform auth (for QA ops / P.R.O.B.E. test runner)
ARCHIE_API_USERNAME=admin
ARCHIE_API_PASSWORD=          # Set to your platform password
